# makefile for impl

TARGET = vsn_impl.so
OBJS =	vsnIsosurf.o \
	vsnInterpolate.o \
	vsnLineStripSet.o \
	vsnStreamLines.o \

OPT=-g -O0
VFR_LIBDIR = ../../vfr/lib

CXX=g++
CXXFLAGS=$(OPT) -fPIC -I$(VFR_LIBDIR)

LINK=$(CXX)
LDFLAGS=-L$(VFR_LIBDIR) -Wl,-rpath,'$$ORIGIN'/$(VFR_LIBDIR) -shared -fPIC $(OPT)
LDLIBS=-lvfr_impl -lGL -lGLU

RM = rm -f
CP = cp

all: $(TARGET)

$(TARGET) : $(OBJS)
	$(CXX) -o $@ $(OBJS) $(LDFLAGS) $(LDLIBS)
	$(RM) lib$(TARGET)
	$(CP) $(TARGET) lib$(TARGET)

clean:
	$(RM) $(OBJS)

distclean: clean
	$(RM) $(TARGET) lib$(TARGET)

