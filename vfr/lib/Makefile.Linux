# makefile for impl

TARGET = vfr_impl.so
OBJS = drawArea_impl.o \
     gfxLetters_impl.o \
     gfxMesh2D_impl.o \
     gfxNode_impl.o \
     gfxTriangles_impl.o \
     gfxVectors_impl.o \
     obj_impl.o \
     obj_io_impl.o \

OPT=-g -O0
INC_DIR = .
BIN_DIR = ../../bin

CXX=g++
CXXFLAGS=$(OPT) -fPIC -I$(INC_DIR)

LINK=$(CXX)
LDFLAGS=-shared -fPIC $(OPT)
LDLIBS=-lGL -lGLU

RM = rm -f
CP = cp

all: $(TARGET)

$(TARGET) : $(OBJS)
	$(CXX) -o $@ $(OBJS) $(LDFLAGS) $(LDLIBS)
	$(RM) lib$(TARGET)
	$(CP) $(TARGET) lib$(TARGET)

install: $(TARGET)
	$(CP) $(TARGET) lib$(TARGET) $(BIN_DIR)/

clean:
	$(RM) $(OBJS)

distclean: clean
	$(RM) $(TARGET) lib$(TARGET)

